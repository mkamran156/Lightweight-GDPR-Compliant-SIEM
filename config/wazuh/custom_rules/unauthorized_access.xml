<!--
  Custom Wazuh rules: unauthorized access and remote-access anomaly
  detection, covering firewall remote-access events and file-integrity
  based unauthorized access indicators.

  Referenced in Section 5.5's discussion of Fig. 14 ("Firewall Remote
  access hits captured at SIEM server") and the MITRE ATT&CK tactics
  'Credential Access' and 'Lateral Movement' called out there.
-->
<group name="unauthorized_access,firewall,">

  <!--
    Remote access session created from an external (non-RFC1918)
    source IP hitting an internal asset - flagged for review, not
    necessarily malicious on its own, but the basis for the frequency
    escalation below.
  -->
  <rule id="100030" level="6">
    <if_sid>31530</if_sid>
    <description>Firewall: remote access session created from external source.</description>
    <mitre>
      <id>T1133</id>
    </mitre>
    <group>firewall,remote_access,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100031" level="10" frequency="10" timeframe="300">
    <if_matched_sid>100030</if_matched_sid>
    <same_source_ip />
    <description>Firewall: unusually high volume of remote access attempts from a single external source (possible reconnaissance or lateral movement staging).</description>
    <mitre>
      <id>T1133</id>
      <id>T1021</id>
    </mitre>
    <group>unauthorized_access,gdpr_IV_35.7.d,</group>
  </rule>

  <!--
    File integrity monitoring alert combined with a recent authentication
    failure from the same host, within a short window - a stronger
    signal of actual unauthorized access rather than a benign config
    change.
  -->
  <rule id="100032" level="12" frequency="1" timeframe="600">
    <if_sid>550,554</if_sid>
    <if_matched_sid>100010</if_matched_sid>
    <description>File integrity change following a recent authentication failure on the same host: possible unauthorized access.</description>
    <mitre>
      <id>T1078</id>
      <id>T1565</id>
    </mitre>
    <group>unauthorized_access,syscheck,gdpr_IV_35.7.d,</group>
  </rule>

</group>
